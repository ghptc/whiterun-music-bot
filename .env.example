DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Optional: register commands only in this server (useful during development).
DISCORD_GUILD_ID=
# Optional Docker build override; rebuild after changing this.
YTDLP_VERSION=2026.08.19
# Optional: Spotify metadata integration (YouTube playback needs no Spotify credentials).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# User authorization-code refresh token; needed for development-mode playlists.
SPOTIFY_REFRESH_TOKEN=
# ISO country code, e.g. BR; set when using client credentials without a user token.
SPOTIFY_MARKET=

# Local SQLite file outside Docker; Compose uses its persistent named volume.
BARD_DB_PATH=bard.db
# Optional partial JSON over DefaultMatchPolicy; duration values are nanoseconds.
SPOTIFY_MATCH_POLICY=
